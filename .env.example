# Semantic memory embeddings
LOCAL_EMBEDDING_MODEL=Xenova/multilingual-e5-large
EMBEDDING_DIMENSIONS=1024

# CockroachDB Cloud Managed MCP
COCKROACH_MCP_URL=https://cockroachlabs.cloud/mcp
COCKROACH_MCP_API_KEY=
