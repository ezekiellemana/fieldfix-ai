NEXT_PUBLIC_API_BASE_URL=


# Backend / Lambda only
DATABASE_URL=

# Agent reasoning
BEDROCK_REASONING_MODEL=global.amazon.nova-2-lite-v1:0
BEDROCK_REASONING_ENABLED=false
